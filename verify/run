#!/usr/bin/env node
import { spawnSync } from "node:child_process";
import { existsSync, mkdtempSync, readFileSync, rmSync, writeFileSync } from "node:fs";
import { tmpdir } from "node:os";
import { join } from "node:path";

const USAGE = `Usage: node verify/run [--only <feature id>]... [--list] [--doctor]

Proves every user-visible feature listed in verify/features.json. Each feature
has one check command. The check runs from the repository root with
AMBITIOUS_HOME set to its own fresh, empty temporary directory, and passes
when it exits 0. Prints one table row per feature.

Options:
  --only <id>  Run only this feature. May be repeated.
  --list       Print the features and their checks without running them.
  --doctor     Check that this checkout is ready to be verified, and stop.
  --help       Print this text.

The full output of every check is kept in a temporary evidence directory
whose path is printed at the end; the temporary AMBITIOUS_HOME directories
are removed.

Exit code 0: every feature passed. 1: at least one failed. 2: could not run.
`;

const repoRoot = join(import.meta.dirname, "..");
const featuresPath = join(import.meta.dirname, "features.json");
const FEATURE_ID = /^[a-z][a-z0-9]*(-[a-z0-9]+)*$/;
const FAILURE_TAIL_LINES = 40;

class CannotRun extends Error {}

const isText = (value) => typeof value === "string" && value.trim() !== "";

const loadFeatures = () => {
  let parsed;
  try {
    parsed = JSON.parse(readFileSync(featuresPath, "utf8"));
  } catch (error) {
    throw new CannotRun(`verify/features.json cannot be read as JSON: ${error.message}`);
  }
  if (!Array.isArray(parsed) || parsed.length === 0) {
    throw new CannotRun('verify/features.json must be a non-empty list of { "id", "userVisible", "check" }.');
  }
  parsed.forEach((feature, index) => {
    const where = `verify/features.json entry ${index + 1}`;
    const keys = Object.keys(feature ?? {}).sort().join(",");
    if (keys !== "check,id,userVisible") throw new CannotRun(`${where} must have exactly the fields id, userVisible and check.`);
    if (!isText(feature.id) || !FEATURE_ID.test(feature.id)) throw new CannotRun(`${where}: id must be lower-case words joined by hyphens.`);
    if (!isText(feature.userVisible)) throw new CannotRun(`${where} (${feature.id}): userVisible must be a plain sentence.`);
    if (!isText(feature.check)) throw new CannotRun(`${where} (${feature.id}): check must be a command.`);
  });
  const ids = parsed.map(({ id }) => id);
  const repeated = ids.find((id, index) => ids.indexOf(id) !== index);
  if (repeated !== undefined) throw new CannotRun(`verify/features.json lists the feature "${repeated}" twice.`);
  return parsed;
};

const parseArgs = (argv) => {
  const options = { only: [], list: false, doctor: false, help: false };
  for (let index = 0; index < argv.length; index += 1) {
    const flag = argv[index];
    if (flag === "--list" || flag === "--doctor" || flag === "--help") {
      options[flag.slice(2)] = true;
    } else if (flag === "--only" && argv[index + 1] !== undefined) {
      options.only.push(argv[index + 1]);
      index += 1;
    } else {
      throw new CannotRun(`Unexpected argument "${flag}". Run with --help for usage.`);
    }
  }
  return options;
};

const table = (header, rows) => {
  const cells = [header, ...rows];
  const widths = header.map((_, column) => Math.max(...cells.map((line) => line[column].length)));
  const format = (line) => line.map((cell, column) => cell.padEnd(widths[column])).join("  ").trimEnd();
  return [format(header), widths.map((width) => "-".repeat(width)).join("  "), ...rows.map(format)].join("\n");
};

const doctor = (features) => {
  const [major] = process.versions.node.split(".");
  const wanted = (() => {
    try {
      return JSON.parse(readFileSync(join(repoRoot, "package.json"), "utf8")).engines?.node ?? null;
    } catch {
      return null;
    }
  })();
  const checks = [
    ["Node", wanted === null || wanted.startsWith(`${major}.`), `running ${process.versions.node}, package.json asks for ${wanted ?? "any"}`],
    [
      "Dependencies",
      !existsSync(join(repoRoot, "package-lock.json")) || existsSync(join(repoRoot, "node_modules")),
      "node_modules is present when the repository has a package-lock.json (run npm ci)",
    ],
    ["Feature list", true, `${features.length} features in verify/features.json`],
  ];
  process.stdout.write(`${table(["Check", "Result", "Detail"], checks.map(([name, ok, detail]) => [name, ok ? "ok" : "FAIL", detail]))}\n`);
  return checks.every(([, ok]) => ok) ? 0 : 1;
};

const runFeature = ({ id, check }, evidence) => {
  const home = mkdtempSync(join(tmpdir(), `ambitious-home-${id}-`));
  try {
    const result = spawnSync(check, {
      shell: true,
      cwd: repoRoot,
      encoding: "utf8",
      env: { ...process.env, AMBITIOUS_HOME: home },
      maxBuffer: 256 * 1024 * 1024,
    });
    const output = `$ ${check}\n${result.stdout ?? ""}${result.stderr ?? ""}${result.error === undefined ? "" : `${result.error.message}\n`}exit ${result.status}\n`;
    writeFileSync(join(evidence, `${id}.log`), output);
    return { passed: result.status === 0, output };
  } finally {
    rmSync(home, { recursive: true, force: true });
  }
};

const run = (argv) => {
  const options = parseArgs(argv);
  if (options.help) {
    process.stdout.write(USAGE);
    return 0;
  }
  const features = loadFeatures();
  const unknown = options.only.find((id) => !features.some((feature) => feature.id === id));
  if (unknown !== undefined) throw new CannotRun(`There is no feature "${unknown}" in verify/features.json.`);
  if (options.doctor) return doctor(features);
  const selected = options.only.length === 0 ? features : features.filter(({ id }) => options.only.includes(id));
  if (options.list) {
    process.stdout.write(`${table(["Feature", "Check", "What a user can rely on"], selected.map(({ id, check, userVisible }) => [id, check, userVisible]))}\n`);
    return 0;
  }
  const evidence = mkdtempSync(join(tmpdir(), "ambitious-verify-evidence-"));
  const results = selected.map((feature) => {
    process.stderr.write(`verify: ${feature.id} ...\n`);
    return { ...feature, ...runFeature(feature, evidence) };
  });
  const failed = results.filter(({ passed }) => !passed);
  for (const { id, output } of failed) {
    process.stdout.write(`Output of the failed check for ${id} (last ${FAILURE_TAIL_LINES} lines):\n${output.trimEnd().split("\n").slice(-FAILURE_TAIL_LINES).join("\n")}\n\n`);
  }
  process.stdout.write(
    `${table(["Feature", "Result", "What a user can rely on"], results.map(({ id, passed, userVisible }) => [id, passed ? "pass" : "FAIL", userVisible]))}\n\n`,
  );
  process.stdout.write(`Full output of every check: ${evidence}\n`);
  process.stdout.write(
    failed.length === 0
      ? `verify: ok. ${results.length} of ${results.length} features pass.\n`
      : `verify: ${failed.length} of ${results.length} features failed: ${failed.map(({ id }) => id).join(", ")}.\n`,
  );
  return failed.length === 0 ? 0 : 1;
};

try {
  process.exitCode = run(process.argv.slice(2));
} catch (error) {
  process.stderr.write(`verify: ${error instanceof CannotRun ? error.message : error.stack}\n`);
  process.exitCode = 2;
}
